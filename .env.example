# LOCAL DEMO ONLY. Do not place production credentials in this file or the repository.
PORT=8768
POWERPATH_V27_AUTH_MODE=local_only
POWERPATH_PG_RUNTIME_EXPERIMENTAL=0
# No POWERPATH_DATABASE_URL or Supabase credentials for the local demo.

# Optional public site-energy sources. Export these in the shell before starting;
# run_local.sh does not automatically load .env files. Empty keys mean unavailable.
POWERPATH_EIA_API_KEY=
POWERPATH_NREL_API_KEY=
# Optional reviewed ArcGIS layers (HTTPS .gov or .arcgis.com, ending in /<layer-id>).
# Set NAME to the actual publisher/dataset and vintage; do not relabel copies as official.
POWERPATH_SUBSTATION_LAYER_URL=
POWERPATH_SUBSTATION_LAYER_NAME=
POWERPATH_TERRITORY_LAYER_URL=
POWERPATH_TERRITORY_LAYER_NAME=
