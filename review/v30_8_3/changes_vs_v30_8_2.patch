+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ enabled: $('enabled').checked, mode: $('mode').value })
+    });
+    await refresh();
+    msg(
+      $('enabled').checked
+        ? `Schedule saved: daily ${$('mode').value === 'live' ? 'live-model' : 'offline-rules'} reviews enabled. Jobs run only while a worker is started.`
+        : 'Schedule saved: daily scheduling is off.'
+    );
+  } catch (e) {
+    msg(e.message, true);
+  }
+});
+$('queue').addEventListener('click', async () => {
+  if (!active) return;
+  try {
+    await api(path('jobs'), {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ role: $('role').value })
+    });
+    await refresh();
+    msg(`${$('role').value} review queued. It will run when a worker is started (see release notes).`);
+  } catch (e) {
+    msg(e.message, true);
+  }
+});
+$('login').addEventListener('submit', async ev => {
+  ev.preventDefault();
+  try {
+    const result = await api('/api/v27/auth/login', {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ email: $('email').value, password: $('password').value })
+    });
+    token = result.access_token;
+    $('password').value = '';
+    $('login').hidden = true;
+    $('logout').hidden = false;
+    await loadProjects();
+  } catch (e) {
+    msg(e.message);
+  }
+});
+$('logout').addEventListener('click', async () => {
+  try {
+    await api('/api/v27/auth/logout', { method: 'POST' });
+  } catch (e) {}
+  token = '';
+  $('logout').hidden = true;
+  $('login').hidden = false;
+  active = '';
+  $('project').replaceChildren();
+  msg('Signed out');
+});
+loadProjects();
