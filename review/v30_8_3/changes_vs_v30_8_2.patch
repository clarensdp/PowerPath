+  try {
+    d = await r.json();
+  } catch {
+    throw Error('The server returned an unreadable response');
+  }
+  if (!r.ok) throw Error(typeof d.detail === 'string' ? d.detail : JSON.stringify(d.detail || d));
+  return d;
+}
+function toast(t) {
