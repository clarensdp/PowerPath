+    if suffix not in SAFE_SUFFIX:
+        raise HTTPException(415, "Unsupported file type")
+    with db() as con:
+        project_exists(con, pid)
+        item = con.execute("SELECT * FROM evidence WHERE id=? AND project_id=?", (eid, pid)).fetchone()
+        if not item:
