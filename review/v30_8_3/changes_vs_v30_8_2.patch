+// v30.8.2: in-page dialog replaces native prompt()/confirm() (blocking, unstyled, sometimes suppressed by browsers).
+function ask({ title, text, input = false, confirm = 'OK' }) {
+  return new Promise(resolve => {
+    const d = document.getElementById('ask');
+    d.querySelector('h2').textContent = title;
+    d.querySelector('p').textContent = text;
+    const field = d.querySelector('textarea');
+    field.hidden = !input;
+    field.value = '';
+    const err = d.querySelector('.err');
+    err.textContent = '';
+    d.querySelector('[data-ok]').textContent = confirm;
+    const done = v => {
+      d.close();
+      d.onclose = null;
+      resolve(v);
+    };
+    d.querySelector('[data-cancel]').onclick = () => done(input ? null : false);
+    d.onclose = () => resolve(input ? null : false);
+    d.querySelector('form').onsubmit = e => {
+      e.preventDefault();
+      if (input) {
+        const v = field.value.trim();
+        if (v.length < 8) {
+          err.textContent = 'Please enter at least 8 characters.';
+          return;
+        }
+        done(v);
+      } else done(true);
+    };
+    d.showModal();
+    if (input) field.focus();
+  });
+}
+const $ = id => document.getElementById(id);
+let active = '';
+let token = '';
+async function api(url, options = {}) {
+  const headers = { ...(options.headers || {}), ...(token ? { Authorization: 'Bearer ' + token } : {}) };
+  const res = await fetch(url, { ...options, headers });
+  const obj = await res.json().catch(() => ({}));
+  if (!res.ok) throw new Error(obj.detail || `${res.status} request failed`);
+  return obj;
+}
+const path = suffix => `/api/projects/${encodeURIComponent(active)}/agents/ops/${suffix}`;
