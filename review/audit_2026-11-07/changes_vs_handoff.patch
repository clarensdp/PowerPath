+.cards span{font-size:.8rem;color:#56676a;display:block;text-transform:uppercase;letter-spacing:.04em}.cards strong{font-size:1.6rem;display:block;margin-top:6px}
+.panel{margin:14px 0}.hint{font-size:.82rem;color:#56676a}.scroller{overflow:auto}
+table{border-collapse:collapse;width:100%;min-width:640px}th,td{text-align:left;padding:11px 8px;border-bottom:1px solid #e4ebe9;font-size:.87rem}th{color:#56676a;font-weight:600}
+pre{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.45;max-height:550px;overflow:auto;background:#f3f6f4;border:1px solid #e1e8e5;border-radius:8px;padding:15px;color:#22393e}
+#approvals{color:#40585c}#notice{color:#236950;font-weight:600}#notice.error{color:#a3352f}
+footer{margin-top:30px;color:#56676a;font-size:.78rem}
+@media(max-width:660px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.wrap{padding:18px 16px}.panel{padding:14px}.eyebrow{float:none;display:block}h1{font-size:1.7rem}}
+[hidden]{display:none!important}
